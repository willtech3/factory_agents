@@ -0,0 +1,313 @@
+"""Live checks for due dates, the overdue flag and GET /todos/overdue (spec_wi-due-dates-overdue).
+
+Usage:
+    python tests/e2e_overdue.py <check> [base_url]        base_url defaults to $BASE_URL
+    python tests/e2e_overdue.py empty-overdue --strict [base_url]
+    python tests/e2e_overdue.py local-all
+    PYTHONPATH=. python tests/e2e_overdue.py rollover-local
+
+<check> is a key of CHECKS below, or `all` to run every check in that order. Each check creates its own todos and
+asserts only on those ids plus single-response invariants, so it passes on an instance already holding todos.
+`empty-overdue --strict` also asserts the overdue list is exactly [] and is valid only on a server holding no
+todos. `local-all` starts the service on a free 127.0.0.1 port, runs `empty-overdue --strict` and then `all`, and
+always stops it. `rollover-local` drives app.storage.today_utc in-process. Exit 0 on pass, else 1 naming the
+failed assertion.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import socket
+import subprocess
+import sys
+import time
+import urllib.error
+import urllib.request
+import uuid
+from datetime import date, datetime, timedelta
+from pathlib import Path
+
+KEYS = ["id", "title", "done", "created_at", "due_date", "overdue"]
+PAST = "2000-01-01"
+FUTURE = "2999-12-31"
+ONE_DAY = timedelta(days=1)
+OMIT = object()
+MALFORMED = [
+    "2026-13-01", "2026-02-30", "0000-01-01", "not-a-date", "", "20261130", "2026-11-30T17:00:00Z",
+    "2026-11-30T00:00:00", "2026-11-30 ", "2026-11-30\n", 20261130, 0, 1700000000, 1.5, True, ["2026-11-30"],
+    "2027-02-29",
+]
+
+
+class CheckFailed(Exception):
+    pass
+
+
+def expect(condition: object, message: str) -> None:
+    if not condition:
+        raise CheckFailed(message)
+
+
+class Client:
+    def __init__(self, base_url: str) -> None:
+        self.base_url = base_url.rstrip("/")
+
+    def call(self, method: str, path: str, body: object = None) -> tuple[int, object]:
+        data = None if body is None else json.dumps(body).encode()
+        headers = {} if data is None else {"Content-Type": "application/json"}
+        request = urllib.request.Request(self.base_url + path, data=data, method=method, headers=headers)
+        try:
+            with urllib.request.urlopen(request, timeout=10) as response:
+                status, raw = response.status, response.read()
+        except urllib.error.HTTPError as error:
+            status, raw = error.code, error.read()
+        try:
+            return status, json.loads(raw)
+        except ValueError:
+            return status, raw.decode(errors="replace")
+
+
+def is_real_date(value: str) -> bool:
+    try:
+        date.fromisoformat(value)
+    except ValueError:
+        return False
+    return True
+
+
+def check_shape(todo: object, ctx: str) -> None:
+    expect(isinstance(todo, dict) and list(todo) == KEYS, f"{ctx}: keys of {todo!r} are not exactly {KEYS}")
+    expect(type(todo["id"]) is int, f"{ctx}: id {todo['id']!r} is not an int")
+    expect(isinstance(todo["title"], str), f"{ctx}: title {todo['title']!r} is not a string")
+    expect(type(todo["done"]) is bool, f"{ctx}: done {todo['done']!r} is not a bool")
+    expect(type(todo["overdue"]) is bool, f"{ctx}: overdue {todo['overdue']!r} is not a bool")
+    expect(isinstance(todo["created_at"], str) and todo["created_at"], f"{ctx}: created_at is empty or not a string")
+    due = todo["due_date"]
+    expect(
+        due is None or (isinstance(due, str) and re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", due) and is_real_date(due)),
+        f"{ctx}: due_date {due!r} is neither null nor a YYYY-MM-DD date",
+    )
+
+
+def create(client: Client, ctx: str, title: str, due: object = OMIT, **extra: object) -> dict:
+    body = {"title": title, **extra}
+    if due is not OMIT:
+        body["due_date"] = due
+    status, todo = client.call("POST", "/todos", body)
+    expect(status == 201, f"{ctx}: POST /todos {body!r} returned {status}, want 201")
+    check_shape(todo, f"{ctx}: POST /todos {body!r}")
+    expect(todo["title"] == title, f"{ctx}: title {todo['title']!r} not echoed, want {title!r}")
+    return todo
+
+
+def complete(client: Client, ctx: str, todo_id: int) -> dict:
+    status, todo = client.call("POST", f"/todos/{todo_id}/complete")
+    expect(status == 200, f"{ctx}: POST /todos/{todo_id}/complete returned {status}, want 200")
+    check_shape(todo, f"{ctx}: POST /todos/{todo_id}/complete")
+    return todo
+
+
+def get_list(client: Client, ctx: str, path: str) -> list[dict]:
+    status, todos = client.call("GET", path)
+    expect(status == 200, f"{ctx}: GET {path} returned {status}, want 200")
+    expect(isinstance(todos, list), f"{ctx}: GET {path} body {todos!r} is not a list")
+    for todo in todos:
+        check_shape(todo, f"{ctx}: GET {path} element")
+    ids = [t["id"] for t in todos]
+    expect(ids == sorted(set(ids)), f"{ctx}: GET {path} ids {ids} are not in ascending order")
+    return todos
+
+
+def check_compat(client: Client) -> None:
+    ctx = "compat"
+    max_before = max((t["id"] for t in get_list(client, ctx, "/todos")), default=0)
+    first = create(client, ctx, "Write the outcome")
+    expect(first["id"] > max_before, f"{ctx}: new id {first['id']} is not above the existing ids (max {max_before})")
+    expect(first["done"] is False, f"{ctx}: done is {first['done']!r}, want false")
+    try:
+        datetime.fromisoformat(first["created_at"])
+    except ValueError:
+        raise CheckFailed(f"{ctx}: created_at {first['created_at']!r} is not ISO-8601") from None
+    expect(first["due_date"] is None, f"{ctx}: title-only due_date is {first['due_date']!r}, want null")
+    expect(first["overdue"] is False, f"{ctx}: title-only overdue is {first['overdue']!r}, want false")
+    second = create(client, ctx, "t", priority="high")
+    expect("priority" not in second, f"{ctx}: unknown field 'priority' echoed in {second!r}")
+    expect(second["id"] > first["id"], f"{ctx}: second id {second['id']} is not above {first['id']}")
+    expect(second["done"] is False and second["due_date"] is None and second["overdue"] is False,
+           f"{ctx}: unknown-field todo {second!r} is not open, undated and not overdue")
+
+
+def check_create_future(client: Client) -> None:
+    ctx = "create-future"
+    future = create(client, ctx, "e2e-create-future", FUTURE)
+    expect(future["due_date"] == FUTURE, f"{ctx}: due_date {future['due_date']!r}, want {FUTURE!r}")
+    expect(future["overdue"] is False, f"{ctx}: due {FUTURE} overdue is {future['overdue']!r}, want false")
+    null = create(client, ctx, "e2e-create-null", None)
+    expect(null["due_date"] is None, f"{ctx}: explicit null due_date echoed as {null['due_date']!r}")
+    expect(null["overdue"] is False, f"{ctx}: null due_date overdue is {null['overdue']!r}, want false")
+
+
+def check_create_past(client: Client) -> None:
+    ctx = "create-past"
+    todo = create(client, ctx, "e2e-create-past", PAST)
+    expect(todo["due_date"] == PAST, f"{ctx}: due_date {todo['due_date']!r}, want {PAST!r}")
+    expect(todo["overdue"] is True, f"{ctx}: due {PAST} overdue is {todo['overdue']!r}, want true")
+    listed = [t for t in get_list(client, ctx, "/todos") if t["id"] == todo["id"]]
+    expect(listed == [todo], f"{ctx}: GET /todos has {listed!r} for id {todo['id']}, want {todo!r}")
+
+
+def check_empty_overdue(client: Client, strict: bool = False) -> None:
+    ctx = "empty-overdue --strict" if strict else "empty-overdue"
+    if strict:
+        overdue = get_list(client, ctx, "/todos/overdue")
+        expect(overdue == [], f"{ctx}: GET /todos/overdue is {overdue!r}, want [] (needs a server holding no todos)")
+    past = create(client, ctx, "e2e-empty-past", PAST)
+    complete(client, ctx, past["id"])
+    own = {past["id"], create(client, ctx, "e2e-empty-future", FUTURE)["id"], create(client, ctx, "e2e-empty-none")["id"]}
+    overdue = get_list(client, ctx, "/todos/overdue")
+    for todo in overdue:
+        expect(todo["overdue"] is True and todo["done"] is False,
+               f"{ctx}: GET /todos/overdue element {todo!r} is not open and overdue")
+        expect(todo["id"] not in own, f"{ctx}: non-overdue todo {todo!r} is in GET /todos/overdue")
+    if strict:
+        expect(overdue == [], f"{ctx}: GET /todos/overdue is {overdue!r} with every past-due todo completed, want []")
+
+
+def check_malformed(client: Client) -> None:
+    ctx = "malformed"
+    probes = []
+    for value in MALFORMED:
+        title = f"e2e-malformed-{uuid.uuid4()}"
+        status, _ = client.call("POST", "/todos", {"title": title, "due_date": value})
+        expect(status == 422, f"{ctx}: due_date {value!r} returned {status}, want 422")
+        probes.append((title, value))
+    titles = {t["title"] for t in get_list(client, ctx, "/todos")}
+    for title, value in probes:
+        expect(title not in titles, f"{ctx}: due_date {value!r} was rejected but a todo titled {title} was stored")
+    leap = create(client, ctx, "e2e-malformed-leap", "2028-02-29")
+    expect(leap["due_date"] == "2028-02-29", f"{ctx}: 2028-02-29 echoed as {leap['due_date']!r}")
+
+
+CHECKS = {
+    "compat": check_compat,
+    "create-future": check_create_future,
+    "create-past": check_create_past,
+    "empty-overdue": check_empty_overdue,
+    "malformed": check_malformed,
+}
+
+
+def run_checks(checks: list[tuple[str, object]]) -> int:
+    failed = 0
+    for label, check in checks:
+        try:
+            check()
+        except Exception as error:  # report any failure, including transport errors, as this check failing
+            failed += 1
+            detail = str(error) if isinstance(error, CheckFailed) else f"{type(error).__name__}: {error}"
+            print(f"FAIL {label}: {detail}")
+        else:
+            print(f"PASS {label}")
+    print(f"{len(checks) - failed} passed, {failed} failed")
+    return 1 if failed else 0
+
+
+def http_checks(names: list[str], client: Client) -> list[tuple[str, object]]:
+    return [(name, lambda check=CHECKS[name]: check(client)) for name in names]
+
+
+def local_all() -> int:
+    with socket.socket() as sock:
+        sock.bind(("127.0.0.1", 0))
+        port = sock.getsockname()[1]
+    base_url = f"http://127.0.0.1:{port}"
+    command = [sys.executable, "-m", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", str(port),
+               "--log-level", "warning"]
+    print(f"starting {' '.join(command)}")
+    server = subprocess.Popen(command, cwd=Path(__file__).resolve().parent.parent)
+    try:
+        deadline = time.monotonic() + 30
+        while True:
+            if server.poll() is not None:
+                print(f"FAIL local-all: server exited with code {server.returncode} before /health answered")
+                return 1
+            try:
+                with urllib.request.urlopen(base_url + "/health", timeout=2) as response:
+                    if response.status == 200:
+                        break
+            except OSError:
+                pass
+            if time.monotonic() > deadline:
+                print("FAIL local-all: /health did not return 200 within 30 seconds")
+                return 1
+            time.sleep(0.1)
+        client = Client(base_url)
+        strict = [("empty-overdue --strict", lambda: check_empty_overdue(client, strict=True))]
+        return run_checks(strict + http_checks(list(CHECKS), client))
+    finally:
+        server.terminate()
+        try:
+            server.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            server.kill()
+            server.wait()
+
+
+def check_rollover_local() -> None:
+    from fastapi.testclient import TestClient
+
+    import app.storage as storage
+    from app.main import app, store
+
+    ctx = "rollover-local"
+    day = date(2026, 11, 30)
+    original = storage.today_utc
+    store.clear()
+    client = TestClient(app)
+    try:
+        storage.today_utc = lambda: day
+        r = client.post("/todos", json={"title": "e2e-rollover", "due_date": day.isoformat()})
+        expect(r.status_code == 201, f"{ctx}: POST /todos returned {r.status_code}, want 201")
+        todo_id = r.json()["id"]
+        for today, want in ((day, False), (day + ONE_DAY, True)):
+            storage.today_utc = lambda today=today: today
+            listed = client.get("/todos").json()
+            overdue = client.get("/todos/overdue").json()
+            for todo in listed + overdue:
+                check_shape(todo, ctx)
+            flags = [t["overdue"] for t in listed if t["id"] == todo_id]
+            expect(flags == [want], f"{ctx}: due {day}, today {today}: GET /todos overdue {flags}, want [{want}]")
+            present = todo_id in [t["id"] for t in overdue]
+            expect(present is want, f"{ctx}: due {day}, today {today}: in GET /todos/overdue is {present}, want {want}")
+    finally:
+        storage.today_utc = original
+        store.clear()
+
+
+def main(argv: list[str]) -> int:
+    strict = "--strict" in argv
+    args = [a for a in argv if a != "--strict"]
+    if not args or (strict and args[0] != "empty-overdue"):
+        print(__doc__)
+        return 1
+    name = args[0]
+    if name == "local-all":
+        return local_all()
+    if name == "rollover-local":
+        return run_checks([(name, check_rollover_local)])
+    if name != "all" and name not in CHECKS:
+        print(f"unknown check {name!r}; known: all, {', '.join(CHECKS)}, local-all, rollover-local")
+        return 1
+    base_url = (args[1] if len(args) > 1 else "") or os.environ.get("BASE_URL", "")
+    if not base_url:
+        print("no base_url argument and $BASE_URL is unset")
+        return 1
+    client = Client(base_url)
+    if name == "empty-overdue":
+        return run_checks([(name + (" --strict" if strict else ""), lambda: check_empty_overdue(client, strict))])
+    return run_checks(http_checks(list(CHECKS) if name == "all" else [name], client))
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
