@@ -0,0 +1,141 @@
+from datetime import date, datetime, timedelta
+
+import pytest
+from fastapi.testclient import TestClient
+
+from app.main import app, store
+
+KEYS = ["id", "title", "done", "created_at", "due_date", "overdue"]
+D = date(2026, 11, 30)
+
+
+@pytest.fixture(autouse=True)
+def clean():
+    store.clear()
+    yield
+    store.clear()
+
+
+@pytest.fixture
+def client():
+    return TestClient(app)
+
+
+@pytest.fixture
+def set_today(monkeypatch):
+    def _set(day: date) -> None:
+        monkeypatch.setattr("app.storage.today_utc", lambda: day)
+
+    _set(D)
+    return _set
+
+
+def create(client, title, due_date="omit"):
+    body = {"title": title} if due_date == "omit" else {"title": title, "due_date": due_date}
+    r = client.post("/todos", json=body)
+    assert r.status_code == 201, r.text
+    return r.json()
+
+
+def assert_shape(todo):
+    assert list(todo) == KEYS
+    assert isinstance(todo["id"], int) and isinstance(todo["title"], str)
+    assert isinstance(todo["done"], bool) and isinstance(todo["overdue"], bool)
+    assert todo["due_date"] is None or (
+        isinstance(todo["due_date"], str)
+        and len(todo["due_date"]) == 10
+        and date.fromisoformat(todo["due_date"]).isoformat() == todo["due_date"]
+    )
+
+
+# AC-7
+def test_overdue_list_is_empty_list_when_nothing_is_overdue(client, set_today):
+    r = client.get("/todos/overdue")
+    assert r.status_code == 200 and r.json() == []
+    past = create(client, "past", "2000-01-01")
+    assert client.post(f"/todos/{past['id']}/complete").status_code == 200
