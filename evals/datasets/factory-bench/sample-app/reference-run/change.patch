@@ -2,7 +2,7 @@
 from __future__ import annotations
 
 import threading
-from dataclasses import asdict, dataclass, field
+from dataclasses import asdict, dataclass, field, replace
 from datetime import date, datetime, timezone
 from typing import Any
 
@@ -25,7 +25,8 @@ def is_overdue(self, today: date | None = None) -> bool:
         return not self.done and self.due_date is not None and date.fromisoformat(self.due_date) < today
 
     def to_dict(self, today: date | None = None) -> dict[str, Any]:
-        return {**asdict(self), "overdue": self.is_overdue(today)}
+        snapshot = replace(self)  # done is read once, so a concurrent complete() cannot split done from overdue
+        return {**asdict(snapshot), "overdue": snapshot.is_overdue(today)}
 
 
