{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "app_kind",
    "journeys",
    "capabilities",
    "questions",
    "profile_path",
    "files",
    "limitations"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "app_kind": {
      "enum": [
        "web",
        "api",
        "worker",
        "library",
        "cli",
        "mobile",
        "desktop",
        "other"
      ]
    },
    "profile_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 30
    },
    "journeys": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "capability"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "available",
          "limitation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "limitation": {
            "type": "string"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,60}$"
          },
          "prompt": {
            "type": "string",
            "maxLength": 2000
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "content": {
            "type": "string",
            "maxLength": 262144
          }
        }
      }
    }
  }
}
