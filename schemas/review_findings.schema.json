{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.example/schemas/review_findings.schema.json",
  "title": "AdversarialReviewFindings",
  "description": "Output of the Reviewer agent for one implementation. The reviewer's job is to break the change: every finding must carry evidence and a refutation condition so the Implementer can either fix it or prove it wrong. 'Looks fine' is a valid result only with the checks that were actually run listed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "spec_id",
    "round",
    "diff_ref",
    "checks_performed",
    "findings",
    "spec_conformance",
    "produced_by"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "pattern": "^rev_[a-z0-9]{8,}$"
    },
    "spec_id": {
      "type": "string"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "diff_ref": {
      "type": "object",
      "required": [
        "base_sha",
        "head_sha",
        "branch"
      ],
      "properties": {
        "base_sha": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        }
      }
    },
    "checks_performed": {
      "type": "array",
      "minItems": 1,
      "description": "What the reviewer actually did. Lets a human (and the eval harness) distinguish a thorough clean review from a lazy one.",
      "items": {
        "type": "object",
        "required": [
          "check",
          "method",
          "result"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "description": "Command run, file read, or reasoning performed."
          },
          "result": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "spec_conformance": {
      "type": "array",
      "description": "One row per acceptance criterion in the spec.",
      "items": {
        "type": "object",
        "required": [
          "ac_id",
          "status",
          "evidence"
        ],
        "properties": {
          "ac_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "met",
              "not_met",
              "untestable_as_written",
              "not_assessed"
            ]
          },
          "evidence": {
            "type": "string",
            "description": "Test name and result, or file:line, or the probe that was run."
          }
        }
      }
    },
    "scope_check": {
      "type": "object",
      "properties": {
        "files_outside_allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unrelated_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "produced_by": {
      "$ref": "provenance.schema.json"
    }
  },
  "$defs": {
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "category",
        "claim",
        "evidence",
        "violates",
        "refutation_condition",
        "status"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^F-[0-9]{1,3}$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "blocking",
            "major",
            "minor",
            "nit"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "correctness",
            "spec_deviation",
            "security",
            "concurrency",
            "data_integrity",
            "performance",
            "error_handling",
            "test_quality",
            "maintainability",
            "scope"
          ]
        },
        "claim": {
          "type": "string",
          "description": "The defect, stated as a falsifiable assertion."
        },
        "evidence": {
          "type": "object",
          "required": [
            "locations"
          ],
          "properties": {
            "locations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "description": "file:line or file:line-line"
              }
            },
            "reproduction": {
              "type": "string",
              "description": "Command or input that demonstrates the problem. Strongly preferred for blocking/major."
            },
            "observed": {
              "type": "string"
            },
            "expected": {
              "type": "string"
            }
          }
        },
        "violates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "AC ids, spec sections, or named invariants. Empty only for maintainability/nit."
        },
        "refutation_condition": {
          "type": "string",
          "description": "What evidence from the implementer would make the reviewer withdraw this finding. Forces the reviewer to commit to a falsifiable position."
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "fixed",
            "refuted",
            "accepted_risk",
            "upheld",
            "withdrawn"
          ],
          "description": "open: new. fixed/refuted/accepted_risk: implementer's response (see review_response). upheld/withdrawn: reviewer's re-evaluation after the response."
        },
        "suggested_fix": {
          "type": "string"
        },
        "pass": {
          "type": "string",
          "description": "Which reviewer pass produced it: '1', '2', ... or 'security'. Set by the orchestrator when merging."
        },
        "cwe": {
          "type": "string",
          "pattern": "^CWE-[0-9]+$",
          "description": "Security findings: the single most specific CWE."
        },
        "attack_path": {
          "type": "string",
          "description": "Security findings: entry point -> trust boundary crossed -> sink, and the precondition an attacker needs."
        },
        "exploitability": {
          "type": "string",
          "enum": [
            "trivial",
            "moderate",
            "hard",
            "theoretical"
          ],
          "description": "Security findings: how hard it is to reach the sink with attacker-controlled input from where the service is exposed."
        },
        "impact": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "description": "Security findings: what an attacker gains (data, control, availability)."
        }
      }
    }
  }
}
