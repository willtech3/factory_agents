{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.example/schemas/spec.schema.json",
  "title": "Specification",
  "description": "One specification per work item, written by the Spec Writer and graded by the Spec Judge. This is the contract the Implementer builds to and the Reviewer reviews against. Acceptance criteria are the primary artifact; everything else supports them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_id", "work_item_id", "decomposition_id", "outcome_id", "revision", "title", "goal", "non_goals", "acceptance_criteria", "interfaces", "allowed_paths", "test_plan", "dependencies", "estimated_lines", "produced_by"],
  "properties": {
    "spec_id": { "type": "string", "pattern": "^spec_[a-z0-9-]{3,}$" },
    "work_item_id": { "type": "string" },
    "decomposition_id": { "type": "string" },
    "outcome_id": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "maxLength": 100 },
    "goal": { "type": "string", "description": "What is true after this is merged that was not true before. One paragraph." },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "context": {
      "type": "string",
      "description": "Relevant current behaviour, with file paths and line references the writer actually read. Keep it to what the implementer needs."
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ac_id", "given", "when", "then", "verification", "user_visible"],
        "properties": {
          "ac_id": { "type": "string", "pattern": "^AC-[0-9]{1,3}$" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" },
          "user_visible": {
            "type": "boolean",
            "description": "true when a user, operator, or external system can observe the behaviour through a deployed surface (HTTP, UI, webhook, email, job output). Every user_visible criterion must be covered by a test_plan.e2e entry; the deterministic e2e_coverage check enforces it. Unit-level invariants (a migration is additive, a class exists) are false."
          },
          "verification": {
            "type": "string",
            "enum": ["automated_test", "manual_check", "metric", "static_check"],
            "description": "How this criterion is verified. automated_test is strongly preferred; the rubric penalises manual_check without justification."
          },
          "surface": {"type": "string", "enum": ["ui", "service", "internal"], "description": "UI criteria require a browser visual e2e entry. If omitted on a spec with a UI interface, every user_visible criterion requires visual coverage."},
          "verification_note": { "type": "string" }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "description": "APIs, events, schemas, CLI flags, or UI contracts this spec introduces or changes. Cross-spec coherence is judged on these.",
      "items": {
        "type": "object",
        "required": ["name", "kind", "change", "definition"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["http_api", "function", "event", "db_schema", "config", "cli", "ui", "file_format", "other"] },
          "change": { "type": "string", "enum": ["new", "modified", "deprecated", "removed"] },
          "definition": { "type": "string", "description": "Signature, schema fragment, or example payload. Precise enough that two implementers would produce compatible code." },
          "consumed_by_specs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Glob patterns the implementer may modify. The deterministic diff-scope check fails the implementation if other paths change."
    },
    "forbidden_changes": { "type": "array", "items": { "type": "string" } },
    "non_functional": {
      "type": "object",
      "properties": {
        "performance": { "type": "string" },
        "security": { "type": "string" },
        "observability": { "type": "string" },
        "backwards_compatibility": { "type": "string" }
      }
    },
    "test_plan": {
      "type": "object",
      "required": ["commands", "new_tests", "e2e"],
      "properties": {
        "commands": { "type": "array", "items": { "type": "string" }, "description": "Exact commands that must pass." },
        "e2e": {
          "type": "array",
          "description": "End-to-end checks run against a running deployment of the change, not against the code. The implementer and reviewer run them against the branch's preview environment; the orchestrator re-runs them against the preview URL in authoritative verification and again against dev after merge. May be empty only when no criterion is user_visible. Agents declare victory without end-to-end verification unless the harness demands it (practitioners.md §3, Anthropic effective harnesses).",
          "items": {
            "type": "object",
            "required": ["covers_ac", "command", "target", "description"],
            "properties": {
              "covers_ac": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "command": { "type": "string", "description": "Shell command that exits 0 on success. $BASE_URL is substituted with the environment URL at run time." },
              "target": { "type": "string", "enum": ["local", "preview"], "description": "local: against a process the command starts itself (docker compose, dev server). preview: against the per-branch preview environment the platform deploys." },
              "visual": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "persona",
                  "viewport",
                  "steps",
                  "environment"
                ],
                "properties": {
                  "persona": {
                    "type": "string",
                    "minLength": 1
                  },
                  "viewport": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "width",
                      "height"
                    ],
                    "properties": {
                      "width": {
                        "type": "integer",
                        "minimum": 320,
                        "maximum": 3840
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 320,
                        "maximum": 2160
                      }
                    }
                  },
                  "steps": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "environment": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "data",
                      "authentication"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "data": {
                        "enum": [
                          "synthetic",
                          "isolated-test"
                        ]
                      },
                      "authentication": {
                        "enum": [
                          "none-required",
                          "test-identity",
                          "production-equivalent"
                        ]
                      },
                      "required_env": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Z][A-Z0-9_]*$"
                        }
                      }
                    }
                  }
                }
              },
              "description": { "type": "string" }
            }
          }
        },
        "new_tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["covers_ac", "description"],
            "properties": {
              "covers_ac": { "type": "array", "items": { "type": "string" } },
              "description": { "type": "string" },
              "suggested_location": { "type": "string" }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "required": ["specs"],
      "properties": {
        "specs": { "type": "array", "items": { "type": "string" } },
        "external": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rollout": {
      "type": "object",
      "properties": {
        "feature_flag": { "type": ["string", "null"] },
        "migration_steps": { "type": "array", "items": { "type": "string" } },
        "rollback": { "type": "string" }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "blocking", "default_if_unanswered"],
        "properties": {
          "question": { "type": "string" },
          "blocking": { "type": "boolean" },
          "default_if_unanswered": { "type": "string" }
        }
      }
    },
    "estimated_size": { "type": "string", "enum": ["XS", "S", "M", "L"], "description": "The band of estimated_lines.hand_written under the run's size budget (default XS ≤ 50, S ≤ 150, M ≤ 400)." },
    "estimated_lines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hand_written", "app", "tests"],
      "description": "Estimated changed lines (added plus removed) a reviewer reads: generated files excluded (linguist-generated in .gitattributes, lockfiles, and the files in `regenerated`). A spec above size M is split. Post-mortem 2026-10-11 §3.",
      "properties": {
        "hand_written": { "type": "integer", "minimum": 0, "description": "app + tests" },
        "app": { "type": "integer", "minimum": 0 },
        "tests": { "type": "integer", "minimum": 0 }
      }
    },
    "regenerated": { "type": "array", "description": "Generated files the change rewrites by running a named command; excluded from the size and reported separately in the pull request.", "items": { "type": "object", "additionalProperties": false, "required": ["paths", "command"], "properties": { "paths": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Globs of the files the command rewrites." }, "command": { "type": "string", "minLength": 1, "description": "The repository command that regenerates them, e.g. `bun run catalog:refresh`." } } } },
    "produced_by": { "$ref": "provenance.schema.json" }
  }
}
